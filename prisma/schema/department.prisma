model Department {
  id            String  @id @default(uuid())
  name          String  @unique
  description   String?
  imageUrl      String?
  imagePublicId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  categories Category[]
  staff      StaffProfile[]
  requests   ServiceRequest[]

  @@map("departments")
}
